{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:categori:esia:ai-skill:v1",
  "title": "Versioned professional E&S AI skill",
  "type": "object",
  "required": ["id", "version", "label", "purpose", "scope", "taskType", "taskProfile", "outputSchema", "outputKinds", "promptVersion", "frameworks", "requiredInputs", "allowedEvidence", "allowedTools", "capabilities", "sourceCitationsRequired", "validationRules", "humanReview", "costPolicy", "sensitivityPolicy", "policy", "instructions", "changeHistory"],
  "properties": {
    "id": {"type": "string", "pattern": "^es\\.[a-z0-9.-]+$", "maxLength": 192}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "label": {"$ref": "#/$defs/text"}, "purpose": {"$ref": "#/$defs/text"}, "scope": {"$ref": "#/$defs/text"},
    "taskType": {"$ref": "#/$defs/text"}, "taskProfile": {"enum": ["conversation", "classification", "assessment", "multidocument", "drafting", "multimodal", "embedding"]}, "outputSchema": {"type": "string", "pattern": "^es\\.[a-z0-9.-]+\\.v[0-9]+$"}, "outputKinds": {"$ref": "#/$defs/strings"}, "promptVersion": {"$ref": "#/$defs/text"},
    "frameworks": {"type": "array", "maxItems": 32, "items": {"type": "object", "required": ["frameworkId", "edition", "standards"], "properties": {"frameworkId": {"$ref": "#/$defs/text"}, "edition": {"$ref": "#/$defs/text"}, "standards": {"$ref": "#/$defs/strings"}, "aliases": {"$ref": "#/$defs/strings"}}}},
    "requiredInputs": {"$ref": "#/$defs/strings"}, "allowedEvidence": {"$ref": "#/$defs/strings"}, "allowedTools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["search_evidence", "read_document_passage", "read_requirement", "propose_assessment"]}}, "capabilities": {"$ref": "#/$defs/strings"}, "sourceCitationsRequired": {"const": true}, "validationRules": {"$ref": "#/$defs/strings"}, "requiresRequirementCoverage": {"type": "boolean"},
    "humanReview": {"type": "object", "required": ["required", "requiredRoles", "finalApprovalRoles", "immutableApprovedSnapshot"], "properties": {"required": {"const": true}, "requiredRoles": {"$ref": "#/$defs/strings"}, "finalApprovalRoles": {"$ref": "#/$defs/strings"}, "immutableApprovedSnapshot": {"const": true}, "professionalMethodologyStatus": {"const": "pending_professional_validation"}}},
    "costPolicy": {"type": "object", "required": ["perRunCeilingRequired", "projectBudgetRequired", "monthlyBudgetRequired", "estimateBeforeExecution", "providerFallback", "cacheReevaluationKeys"], "properties": {"perRunCeilingRequired": {"const": true}, "projectBudgetRequired": {"const": true}, "monthlyBudgetRequired": {"const": true}, "estimateBeforeExecution": {"const": true}, "providerFallback": {"const": "deny"}, "cacheReevaluationKeys": {"$ref": "#/$defs/strings"}}},
    "sensitivityPolicy": {"type": "object", "required": ["sourceAuthorizationRequired", "reauthorizeBeforeDispatch", "minimizeContext", "providerClassificationRequired", "localOnlyHasNoRemoteFallback", "retention", "projectInstructionsCannotOverridePlatformPolicy"], "properties": {"sourceAuthorizationRequired": {"const": true}, "reauthorizeBeforeDispatch": {"const": true}, "minimizeContext": {"const": true}, "providerClassificationRequired": {"const": true}, "localOnlyHasNoRemoteFallback": {"const": true}, "retention": {"const": "configured_organization_policy"}, "projectInstructionsCannotOverridePlatformPolicy": {"const": true}}},
    "policy": {"type": "object", "required": ["source_citations_required", "missing_evidence_must_be_flagged", "unapproved_database_writes", "human_review_required", "provider_fallback"], "properties": {"source_citations_required": {"const": true}, "missing_evidence_must_be_flagged": {"const": true}, "unapproved_database_writes": {"const": false}, "human_review_required": {"const": true}, "provider_fallback": {"const": "deny"}}},
    "instructions": {"type": "string", "minLength": 1, "maxLength": 20000}, "changeHistory": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"type": "object", "required": ["version", "date", "change"], "properties": {"version": {"$ref": "#/$defs/text"}, "date": {"type": "string", "format": "date"}, "change": {"$ref": "#/$defs/text"}}}}
  },
  "$defs": {"text": {"type": "string", "minLength": 1, "maxLength": 8000}, "strings": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}
}
