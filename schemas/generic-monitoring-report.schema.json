{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esia.categori.se/schemas/generic-monitoring-report.schema.json",
  "title": "E&S Review generic monitoring report reference manifest",
  "description": "Proposed report projection contract over existing approved engagement snapshots. It stores no duplicate evidence, findings, measures or observations. The host must resolve record IDs within the exact approved snapshot, enforce audience disclosure and reporting-period scope, and retain issuance provenance. Source-specific template requirements remain separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "audience",
    "sourceSnapshot",
    "engagementId",
    "projectId",
    "cycleId",
    "profile",
    "sections",
    "disclosureApplied"
  ],
  "properties": {
    "format": {
      "const": "esia-monitoring-report-reference-manifest"
    },
    "schemaVersion": {
      "const": 1
    },
    "audience": {
      "enum": [
        "monitoring_visit",
        "periodic_client_performance",
        "independent_lender_supervision"
      ]
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "engagement-exchange.schema.json#/$defs/snapshot/properties/id"
        },
        "sha256": {
          "$ref": "engagement-exchange.schema.json#/$defs/snapshot/properties/sha256"
        }
      }
    },
    "engagementId": {
      "$ref": "engagement-exchange.schema.json#/$defs/engagement/properties/id"
    },
    "projectId": {
      "$ref": "engagement-exchange.schema.json#/$defs/engagement/properties/projectId"
    },
    "cycleId": {
      "$ref": "engagement-exchange.schema.json#/$defs/cycles/properties/id"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "origin"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 192
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "origin": {
          "const": "application_authored"
        },
        "sourceReferenceVersionIds": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "recordGroups",
          "missingInputs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 192
          },
          "recordGroups": {
            "type": "array",
            "maxItems": 12,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "requirements"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/requirements/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "assertions"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/assertions/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "findings"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/findings/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "actions"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/actions/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "obligations"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/obligations/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "monitoringObligations"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/monitoringObligations/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "indicators"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/indicators/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "measurements"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/measurements/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "missions"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/missions/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "events"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/events/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "verifications"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/verifications/properties/id"
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "register",
                    "recordIds"
                  ],
                  "properties": {
                    "register": {
                      "const": "approvals"
                    },
                    "recordIds": {
                      "type": "array",
                      "uniqueItems": true,
                      "maxItems": 10000,
                      "items": {
                        "$ref": "engagement-exchange.schema.json#/$defs/approvals/properties/id"
                      }
                    }
                  }
                }
              ]
            }
          },
          "missingInputs": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4000
            }
          }
        }
      }
    },
    "disclosureApplied": {
      "const": true
    }
  },
  "$comment": "This proposed JSON Schema documents reference shape, not authorization, actual approval, cross-record integrity or content completeness. Existing server validation and approved issuance remain authoritative. The manifest is an export/projection, not an independent project data store."
}
