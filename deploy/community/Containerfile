# Build only from tools/build-community-source.mjs output, never the private repo.
# npm is a build tool only. Both bases are immutable, resolved 2026-10-25.
FROM docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53 AS dependencies
WORKDIR /opt/esia
COPY package.json package-lock.json ./
COPY vendor ./vendor
RUN npm ci --omit=dev --omit=optional --ignore-scripts --no-audit --no-fund && npm cache clean --force
# The Alpine/musl runtime removes the affected Debian glibc/GCC dependencies.
# npm/yarn are build tools, so their code is removed from the runtime stage.
# OS package metadata remains intact for vulnerability and license inspection.
FROM docker.io/library/node:24.22.1-alpine@sha256:06d7adf3e0ef61a13f1d28682726366f97a15aa1888c934d3ecec86c33918b53
ARG COMMUNITY_SOURCE_TREE_SHA256
LABEL io.categori.esia.community-source-tree-sha256=$COMMUNITY_SOURCE_TREE_SHA256
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-v* /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/corepack
WORKDIR /opt/esia
COPY --from=dependencies --chown=1000:1000 /opt/esia/node_modules ./node_modules
COPY --chown=1000:1000 . .
# Reject an omitted/stale build argument; the installed checker separately checks
# every source file before image acceptance (runtime COPY excludes test files).
RUN node --input-type=module -e 'import{readFileSync}from"node:fs";import{createHash}from"node:crypto";const m=JSON.parse(readFileSync("community-source-manifest.json")),s=process.env.COMMUNITY_SOURCE_TREE_SHA256;const tree=createHash("sha256").update(JSON.stringify(m.files,null,2)+"\n").digest("hex");if(m.format!=="esia-community-source-candidate"||!/^[a-f0-9]{64}$/.test(s||"")||s!==m.sourceTreeSha256||s!==tree)throw Error("Supply the exact verified Community sourceTreeSha256 as COMMUNITY_SOURCE_TREE_SHA256.");'
ENV NODE_ENV=production
USER 1000:1000
ENTRYPOINT []
# Linux host networking preserves the exact loopback Host/Origin boundary.
# /data is mounted by the operator; client bytes never enter an image layer.
CMD ["node", "server/local-workspace.mjs", "--data", "/data", "--port", "4173"]
